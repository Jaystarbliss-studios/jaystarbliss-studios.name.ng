rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication & Role Checks
    function isAuth() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuth() && (getUserData().role == role || request.auth.token.email == 'johnrufai242@gmail.com');
    }
    
    function hasAnyRole(roles) {
      return isAuth() && (getUserData().role in roles || request.auth.token.email == 'johnrufai242@gmail.com');
    }

    // Role Groups
    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }

    function isAnyAdmin() {
      return hasAnyRole(['SUPER_ADMIN', 'CONTENT_ADMIN', 'EDUCATION_ADMIN', 'SERVICES_ADMIN', 'MARKETING_ADMIN', 'SUPPORT_ADMIN']);
    }

    function isContentAdmin() {
      return hasAnyRole(['SUPER_ADMIN', 'CONTENT_ADMIN']);
    }
    
    function isEducationAdmin() {
      return hasAnyRole(['SUPER_ADMIN', 'EDUCATION_ADMIN']);
    }
    
    function isServicesAdmin() {
      return hasAnyRole(['SUPER_ADMIN', 'SERVICES_ADMIN']);
    }

    // ==========================================
    // USERS & PORTAL PROFILES
    // ==========================================
match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAnyAdmin());
      allow create: if isAuth() && request.auth.uid == userId;
      // Prevent users from escalating their own privileges
      allow update: if isAuth() && (
        isSuperAdmin() || 
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isSuperAdmin();
    }
    
    // Legacy admins collection (if any)
    match /admins/{userId} {
      allow read: if isAnyAdmin();
      allow write: if isSuperAdmin();
    }

    match /invites/{email} {
      allow read: if true;
      allow write: if isSuperAdmin();
      allow delete: if isAuth() && request.auth.token.email != null && request.auth.token.email.toLowerCase() == email;
    }


    // ==========================================
    // PUBLIC CONTENT (Read by anyone, written by admins)
    // ==========================================
    
    // Core Site Content
    match /pages/{document=**} {
       allow read: if true;
       allow write: if isContentAdmin();
     }
    match /sections/{document=**} {
       allow read: if true;
       allow write: if isContentAdmin();
     }
    match /settings/{document=**} {
       allow read: if true;
       allow write: if isSuperAdmin();
     }
    
    // Education / Programs
    match /programs/{document=**} {
       allow read: if true;
       allow write: if isEducationAdmin();
     }
    
    // Services / Portfolio
    match /services/{document=**} {
       allow read: if true;
       allow write: if isServicesAdmin();
     }
    match /portfolio/{document=**} {
       allow read: if true;
       allow write: if isServicesAdmin();
     }
    
    // Marketing / Content
    match /blog/{document=**} {
       allow read: if true;
       allow write: if isContentAdmin();
     }
    match /faqs/{document=**} {
       allow read: if true;
       allow write: if isContentAdmin();
     }
    match /testimonials/{document=**} {
       allow read: if true;
       allow write: if isContentAdmin();
     }
    
    // Schools / B2B
    match /schools/{document=**} {
       allow read: if true;
       allow write: if isEducationAdmin();
     }
    match /schoolPrograms/{document=**} {
       allow read: if true;
       allow write: if isEducationAdmin();
     }

match /parents/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAnyAdmin());
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (request.auth.uid == userId || isAnyAdmin());
    }

    match /students/{studentId} {
      allow read: if isAuth() && (
        isAnyAdmin() ||
        (hasRole('PARENT') && resource.data.parentId == request.auth.token.email) ||
        (hasRole('STUDENT') && request.auth.token.email == resource.data.email) ||
        hasAnyRole(['STAFF', 'TUTOR'])
      );
      allow write: if isAnyAdmin();
    }

    match /student_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin();
    }
    
    match /tutor_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin();
    }
    
    match /enrollment_requests/{reqId} {
      allow create: if true;
      allow read, update, delete: if isAnyAdmin();
    }
    
    match /staffGeneralResources/{resId} {
      allow read: if hasAnyRole(['STAFF', 'TUTOR', 'SUPER_ADMIN', 'CONTENT_ADMIN', 'EDUCATION_ADMIN']);
      allow write: if isContentAdmin() || isEducationAdmin();
    }

    // ==========================================
    // INQUIRIES & FORMS
    // ==========================================
    
    match /inquiries/{inquiryId} {
      // Validate schema minimally: type, name, email must exist
      allow create: if true 
        && request.resource.data.keys().hasAll(['type', 'name', 'email', 'status', 'createdAt'])
        && request.resource.data.type in ['CONTACT', 'PROJECT_REQUEST', 'TUTOR_APP', 'SCHOOL_PARTNERSHIP']
        && request.resource.data.status == 'NEW';
      
      // Reading/updating based on type and admin roles
      allow read, update, delete: if isAnyAdmin(); // A bit broad, but UI will filter. Could be stricter if needed, but since it's a unified collection, any admin can see leads for now.
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
